#!/usr/bin/env bash
# Configure Nginx to run as nginx and listen on port 8080
pkill apache2
chmod 644 /etc/nginx/nginx.conf
sed -Ei 's/^\s*#?\s*user\s+.*;/user nginx;/' /etc/nginx/nginx.conf
sed -Ei 's/(listen (\[::\]:)?)80\b/\18080/' /etc/nginx/sites-enabled/default
sudo -u nginx service nginx restart
