#!/usr/bin/env bash
# Installs HAProxy and load balances web-01 and web-02 with roundrobin
apt-get update -y
apt-get install -y haproxy
if grep -q "^ENABLED=" /etc/default/haproxy; then
    sed -i 's/^ENABLED=.*/ENABLED=1/' /etc/default/haproxy
else
    echo "ENABLED=1" >> /etc/default/haproxy
fi
if ! grep -q "7257-web-01" /etc/haproxy/haproxy.cfg; then
    cat >> /etc/haproxy/haproxy.cfg << EOF

frontend http-in
    bind *:80
    mode http
    default_backend web_servers

backend web_servers
    mode http
    balance roundrobin
    server 7257-web-01 18.132.43.17:80 check
    server 7257-web-02 35.178.171.98:80 check
EOF
fi
service haproxy restart
